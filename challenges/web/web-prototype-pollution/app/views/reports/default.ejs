<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Config API</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <span class="navbar-brand">Corporate Config API - Reports</span>
  </div>
</nav>
<div class="container mt-4">
  <div class="card shadow">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0">System Report - <%= title %></h5>
    </div>
    <div class="card-body">
      <h6>User Information</h6>
      <table class="table table-sm table-bordered">
        <tr><th>Username</th><td><%= user.username %></td></tr>
        <tr><th>Role</th><td><%= user.role %></td></tr>
      </table>
      <h6>Configuration Snapshot</h6>
      <table class="table table-sm table-bordered">
        <tr><th>Theme</th><td><%= config.theme %></td></tr>
        <tr><th>Language</th><td><%= config.language %></td></tr>
        <tr><th>Debug</th><td><%= config.debug %></td></tr>
      </table>
      <p class="text-muted small">Report generated at: <%= new Date().toISOString() %></p>
    </div>
  </div>
</div>
</body>
</html>
