<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard - Config API</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <span class="navbar-brand">Corporate Config API</span>
    <span class="navbar-text text-white">Welcome, <%= user.username %> (<%= user.role %>)</span>
  </div>
</nav>
<div class="container mt-4">
  <div class="row">
    <div class="col-md-6">
      <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">Current Configuration</h5>
        </div>
        <div class="card-body">
          <table class="table table-sm">
            <tr><th>Theme</th><td><%= config.theme %></td></tr>
            <tr><th>Language</th><td><%= config.language %></td></tr>
            <tr><th>Debug</th><td><%= config.debug %></td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">Update Configuration</h5>
        </div>
        <div class="card-body">
          <p class="small text-muted">Send JSON to POST /api/config to update settings. The system merges your config with the base config.</p>
          <div class="mb-2">
            <code>curl -X POST /api/config -d '{"theme":"dark"}'</code>
          </div>
          <a href="/report?template=default" class="btn btn-outline-primary btn-sm">View Report</a>
        </div>
      </div>
    </div>
  </div>
  <div class="card shadow">
    <div class="card-header">
      <h5 class="mb-0">API Documentation</h5>
    </div>
    <div class="card-body">
      <h6>POST /api/config</h6>
      <p>Update the application configuration. Accepts a JSON object that will be merged with the current configuration.</p>
      <pre class="bg-dark text-light p-3 rounded"><code>curl -X POST http://localhost:8080/api/config \
  -H "Content-Type: application/json" \
  -H "Cookie: &lt;session&gt;" \
  -d '{"theme": "dark", "language": "es"}'</code></pre>
      <h6>GET /report?template=&lt;name&gt;</h6>
      <p>Render a report template. Available: default</p>
    </div>
  </div>
</div>
</body>
</html>
