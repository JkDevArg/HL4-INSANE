<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Config API</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark">
  <div class="container">
    <span class="navbar-brand">Corporate Config API</span>
    <div>
      <a href="/login" class="btn btn-outline-light btn-sm me-2">Login</a>
    </div>
  </div>
</nav>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Corporate Configuration API v2.1</h4>
        </div>
        <div class="card-body">
          <p class="lead">Welcome to the flexible configuration management system.</p>
          <h5>Current Configuration</h5>
          <table class="table table-bordered">
            <tr><th>Theme</th><td><%= config.theme %></td></tr>
            <tr><th>Language</th><td><%= config.language %></td></tr>
            <tr><th>Debug Mode</th><td><%= config.debug %></td></tr>
          </table>
          <div class="alert alert-info">
            <strong>API Endpoints:</strong><br>
            POST /api/config - Update configuration<br>
            GET /report?template=default - Generate report
          </div>
          <a href="/login" class="btn btn-primary">Login to Access Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
