      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (team_id) (count_over_time({source=\"vpn\", event_type=\"vpn_ban\"} [$__range]))",
          "legendFormat": "{{team_id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Eventos de ban (detalle)",
