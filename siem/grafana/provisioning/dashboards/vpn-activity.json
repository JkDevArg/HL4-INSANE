  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Conexiones VPN por equipo (rate)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (team_id) (count_over_time({source=\"vpn\", event_type=\"vpn_connect\"} [5m]))",
          "legendFormat": "{{team_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Desconexiones VPN por equipo (rate)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (team_id) (count_over_time({source=\"vpn\", event_type=\"vpn_disconnect\"} [5m]))",
          "legendFormat": "{{team_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Contador de desconexiones (total por equipo)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (team_id) (count_over_time({source=\"vpn\", event_type=\"vpn_disconnect\"} [$__range]))",
          "legendFormat": "{{team_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
