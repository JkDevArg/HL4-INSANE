    {
      "id": 1,
      "type": "timeseries",
      "title": "Alertas Suricata por firma (nmap/scans/exploits)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (signature) (count_over_time({job=\"suricata\", event_type=\"alert\"} [5m]))",
          "legendFormat": "{{signature}}"
        }
      ]
    },
    {
      "id": 2,
