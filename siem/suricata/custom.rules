# =============================================================================
# custom.rules — Reglas IDS locales del CTF (CTFHL4-INSANE)
# =============================================================================
#
# Objetivo del usuario: "si ejecutan nmap se debe ver".
# Detectamos: escaneos nmap (SYN/NULL/FIN/XMAS/version/ping-sweep), escaneo
# de puertos, fuerza bruta SSH/HTTP, y firmas de exploits web comunes.
#
# CONVENCIONES
#   - SID en rango LOCAL: 1000000+ (reservado para reglas propias).
#   - rev:1 en todas; incrementar al modificar una regla.
#   - msg claro y prefijado por categoría: [NMAP], [SCAN], [BRUTE], [WEB-EXPLOIT].
#   - Estas alertas salen a eve.json → Promtail → Loki (job=suricata) → Grafana
#     (dashboard ids-alerts.json).
#
# CÓMO AÑADIR MÁS REGLAS
#   1. Copia una línea existente y cámbiale el patrón.
#   2. Asigna un SID nuevo y único >= 1000000 (no reutilices).
#   3. Pon rev:1 y un msg descriptivo con su categoría.
#   4. Recarga: `suricatasc -c reload-rules` o reinicia el contenedor.
#   5. Valida sintaxis sin arrancar: `suricata -T -c suricata.yaml`.
#
# NOTA: HOME_NET = 10.10.0.0/16 (toda la VPN). Ver suricata.yaml.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) DETECCIÓN DE NMAP  [NMAP]
# -----------------------------------------------------------------------------

# 1.1 NULL scan (nmap -sN): paquete TCP sin flags activos. Patológico => scan.
alert tcp any any -> $HOME_NET any (msg:"[NMAP] NULL scan detectado (sin flags TCP)"; flow:stateless; flags:0; classtype:attempted-recon; sid:1000001; rev:1;)

# 1.2 FIN scan (nmap -sF): solo flag FIN, sin sesión establecida.
alert tcp any any -> $HOME_NET any (msg:"[NMAP] FIN scan detectado"; flow:stateless; flags:F,12; classtype:attempted-recon; sid:1000002; rev:1;)

# 1.3 XMAS scan (nmap -sX): FIN+PSH+URG encendidos ("árbol de navidad").
alert tcp any any -> $HOME_NET any (msg:"[NMAP] XMAS scan detectado (FIN+PSH+URG)"; flow:stateless; flags:FPU,12; classtype:attempted-recon; sid:1000003; rev:1;)

# 1.4 SYN scan / half-open (nmap -sS): muchos SYN en poco tiempo a distintos
#     puertos del mismo host. threshold por src para no spamear.
alert tcp any any -> $HOME_NET any (msg:"[NMAP] SYN scan / barrido de puertos (half-open)"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000004; rev:1;)

# 1.5 Version scan (nmap -sV): firma típica del probe de servicios de nmap.
alert tcp any any -> $HOME_NET any (msg:"[NMAP] Service/Version scan (-sV) probe"; flow:to_server,established; content:"|0d 0a|"; content:"nmap"; nocase; classtype:attempted-recon; sid:1000005; rev:1;)

# 1.6 Ping sweep (nmap -sn): ICMP echo a múltiples destinos desde una src.
alert icmp any any -> $HOME_NET any (msg:"[NMAP] Ping sweep (barrido ICMP echo)"; itype:8; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:1000006; rev:1;)

# 1.7 User-Agent de Nmap NSE (scripts HTTP de nmap).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[NMAP] User-Agent de Nmap NSE en HTTP"; flow:to_server,established; http.user_agent; content:"Nmap"; nocase; classtype:web-application-attack; sid:1000007; rev:1;)


# -----------------------------------------------------------------------------
# 2) ESCANEO DE PUERTOS GENÉRICO  [SCAN]
# -----------------------------------------------------------------------------

# 2.1 Muchos RST recibidos por una src (síntoma de barrido a puertos cerrados).
alert tcp $HOME_NET any -> any any (msg:"[SCAN] Multiples RST -> posible escaneo de puertos"; flags:R; flow:stateless; threshold:type both, track by_dst, count 30, seconds 10; classtype:attempted-recon; sid:1000010; rev:1;)

# 2.2 Conexiones a muchos puertos distintos del mismo destino (horizontal/vertical).
alert tcp any any -> $HOME_NET any (msg:"[SCAN] Escaneo vertical de puertos (muchos puertos, mismo host)"; flags:S; flow:stateless; threshold:type both, track by_src, count 40, seconds 10; classtype:attempted-recon; sid:1000011; rev:1;)


# -----------------------------------------------------------------------------
# 3) FUERZA BRUTA  [BRUTE]
# -----------------------------------------------------------------------------

# 3.1 Fuerza bruta SSH: muchas conexiones nuevas al puerto 22 desde una src.
alert tcp any any -> $HOME_NET 22 (msg:"[BRUTE] Posible fuerza bruta SSH (conexiones repetidas)"; flow:to_server; flags:S; threshold:type both, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:1000020; rev:1;)

# 3.2 Fuerza bruta de login HTTP: muchos POST a /login desde una src.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[BRUTE] Posible fuerza bruta de login HTTP (POST repetidos)"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"login"; nocase; threshold:type both, track by_src, count 15, seconds 30; classtype:web-application-attack; sid:1000021; rev:1;)

# 3.3 HTTP 401 repetidos hacia la misma src (respuestas de auth fallida).
alert http $HOME_NET $HTTP_PORTS -> any any (msg:"[BRUTE] Multiples 401 Unauthorized -> brute-force HTTP basic"; flow:to_client,established; http.stat_code; content:"401"; threshold:type both, track by_dst, count 15, seconds 30; classtype:web-application-attack; sid:1000022; rev:1;)


# -----------------------------------------------------------------------------
# 4) FIRMAS DE EXPLOITS / HERRAMIENTAS WEB  [WEB-EXPLOIT]
# -----------------------------------------------------------------------------

# 4.1 sqlmap (User-Agent por defecto).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] sqlmap detectado (User-Agent)"; flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000030; rev:1;)

# 4.2 Nikto scanner (User-Agent).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Nikto scanner detectado (User-Agent)"; flow:to_server,established; http.user_agent; content:"Nikto"; nocase; classtype:web-application-attack; sid:1000031; rev:1;)

# 4.3 dirb / gobuster / ffuf / dirbuster (fuzzing de directorios por User-Agent).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Fuzzing de directorios (gobuster/dirb/ffuf) User-Agent"; flow:to_server,established; http.user_agent; pcre:"/(gobuster|dirbuster|^dirb|ffuf|wfuzz|feroxbuster)/i"; classtype:web-application-attack; sid:1000032; rev:1;)

# 4.4 Path traversal (../../ y variantes URL-encoded).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Intento de path traversal (../)"; flow:to_server,established; http.uri; pcre:"/(\.\.\/|\.\.%2f|%2e%2e%2f|\.\.\\)/i"; classtype:web-application-attack; sid:1000033; rev:1;)

# 4.5 Webshells comunes en la URI.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Acceso a posible webshell (c99/r57/cmd.php/shell.php)"; flow:to_server,established; http.uri; pcre:"/(c99\.php|r57\.php|cmd\.php|shell\.php|b374k|wso\.php)/i"; classtype:web-application-attack; sid:1000034; rev:1;)

# 4.6 SQLi básica en query string (UNION SELECT / OR 1=1).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Posible SQL injection (UNION SELECT / OR 1=1)"; flow:to_server,established; http.uri; pcre:"/(union(\s|\+|%20)+select|or(\s|\+|%20)+1(\s|%20)*=(\s|%20)*1)/i"; classtype:web-application-attack; sid:1000035; rev:1;)

# 4.7 Burp Suite / scanners en User-Agent (recon ofensivo).
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[WEB-EXPLOIT] Herramienta ofensiva en User-Agent (curl/python/burp/nuclei)"; flow:to_server,established; http.user_agent; pcre:"/(burp|nuclei|nessus|acunetix|masscan|zgrab)/i"; classtype:web-application-attack; sid:1000036; rev:1;)


# -----------------------------------------------------------------------------
# 5) DETECCIÓN DE USO DE IA  [AI-DETECT]
# -----------------------------------------------------------------------------
# Detectamos intentos de uso de LLMs/IA desde la VPN del CTF.
# Capas de detección:
#   a) TLS SNI (ClientHello — sin descifrar el tráfico)
#   b) HTTP Host header (tráfico no cifrado o tras proxy)
#   c) HTTP User-Agent (SDKs de IA conocidos)
#   d) DNS queries para dominios de IA
#
# NOTA: el sinkhole dnsmasq (0.0.0.0) bloquea la mayoría. Estas reglas ALERTAN
# incluso si el sinkhole falla (cliente con DNS propio / IP directa).
# Todas las alertas van a eve.json → Loki → Grafana (dashboard ai-alerts).

# 5.1 TLS SNI — OpenAI / ChatGPT
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI OpenAI/ChatGPT detectado"; flow:to_server,established; tls.sni; content:"openai.com"; nocase; classtype:policy-violation; sid:1000050; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI ChatGPT detectado"; flow:to_server,established; tls.sni; content:"chatgpt.com"; nocase; classtype:policy-violation; sid:1000051; rev:1;)

# 5.2 TLS SNI — Anthropic / Claude
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Anthropic/Claude detectado"; flow:to_server,established; tls.sni; content:"anthropic.com"; nocase; classtype:policy-violation; sid:1000052; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Claude.ai detectado"; flow:to_server,established; tls.sni; content:"claude.ai"; nocase; classtype:policy-violation; sid:1000053; rev:1;)

# 5.3 TLS SNI — Google Gemini / Bard / Vertex AI
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Google Gemini detectado"; flow:to_server,established; tls.sni; content:"gemini.google.com"; nocase; classtype:policy-violation; sid:1000054; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Google AI Studio detectado"; flow:to_server,established; tls.sni; content:"generativelanguage.googleapis.com"; nocase; classtype:policy-violation; sid:1000055; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Vertex AI detectado"; flow:to_server,established; tls.sni; content:"aiplatform.googleapis.com"; nocase; classtype:policy-violation; sid:1000056; rev:1;)

# 5.4 TLS SNI — Microsoft Copilot / Bing AI / Azure OpenAI
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Microsoft Copilot detectado"; flow:to_server,established; tls.sni; content:"copilot.microsoft.com"; nocase; classtype:policy-violation; sid:1000057; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Azure OpenAI detectado"; flow:to_server,established; tls.sni; content:"openai.azure.com"; nocase; classtype:policy-violation; sid:1000058; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Bing AI detectado"; flow:to_server,established; tls.sni; content:"sydney.bing.com"; nocase; classtype:policy-violation; sid:1000059; rev:1;)

# 5.5 TLS SNI — Perplexity / Poe / DeepSeek / Mistral / xAI
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Perplexity AI detectado"; flow:to_server,established; tls.sni; content:"perplexity.ai"; nocase; classtype:policy-violation; sid:1000060; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI DeepSeek detectado"; flow:to_server,established; tls.sni; content:"deepseek.com"; nocase; classtype:policy-violation; sid:1000061; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Mistral AI detectado"; flow:to_server,established; tls.sni; content:"mistral.ai"; nocase; classtype:policy-violation; sid:1000062; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI xAI/Grok detectado"; flow:to_server,established; tls.sni; content:"x.ai"; nocase; classtype:policy-violation; sid:1000063; rev:1;)

# 5.6 TLS SNI — AI coding assistants
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Cursor AI detectado"; flow:to_server,established; tls.sni; content:"cursor.sh"; nocase; classtype:policy-violation; sid:1000064; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI Codeium detectado"; flow:to_server,established; tls.sni; content:"codeium.com"; nocase; classtype:policy-violation; sid:1000065; rev:1;)
alert tls $HOME_NET any -> any any (msg:"[AI-DETECT] TLS SNI GitHub Copilot proxy detectado"; flow:to_server,established; tls.sni; content:"copilot-proxy.githubusercontent.com"; nocase; classtype:policy-violation; sid:1000066; rev:1;)

# 5.7 HTTP Host header — APIs de IA (tráfico plano o tras proxy)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] HTTP Host OpenAI API detectado"; flow:to_server,established; http.header; content:"Host: api.openai.com"; nocase; classtype:policy-violation; sid:1000070; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] HTTP Host Anthropic API detectado"; flow:to_server,established; http.header; content:"Host: api.anthropic.com"; nocase; classtype:policy-violation; sid:1000071; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] HTTP Host Google Generative AI detectado"; flow:to_server,established; http.header; content:"generativelanguage.googleapis.com"; nocase; classtype:policy-violation; sid:1000072; rev:1;)

# 5.8 HTTP User-Agent — SDKs de IA conocidos
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] SDK Python OpenAI detectado (User-Agent)"; flow:to_server,established; http.user_agent; content:"openai-python"; nocase; classtype:policy-violation; sid:1000080; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] SDK Anthropic Python detectado (User-Agent)"; flow:to_server,established; http.user_agent; content:"anthropic-sdk-python"; nocase; classtype:policy-violation; sid:1000081; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] SDK LangChain detectado (User-Agent)"; flow:to_server,established; http.user_agent; content:"langchain"; nocase; classtype:policy-violation; sid:1000082; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] API call con Bearer hacia IA (Authorization + /v1/chat)"; flow:to_server,established; http.uri; content:"/v1/chat/completions"; nocase; classtype:policy-violation; sid:1000083; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] API call OpenAI /v1/completions"; flow:to_server,established; http.uri; content:"/v1/completions"; nocase; classtype:policy-violation; sid:1000084; rev:1;)
alert http $HOME_NET any -> any any (msg:"[AI-DETECT] API call Anthropic /v1/messages"; flow:to_server,established; http.uri; content:"/v1/messages"; http.header; content:"anthropic"; nocase; classtype:policy-violation; sid:1000085; rev:1;)

# 5.9 DNS queries directas hacia dominios de IA (refuerzo del sinkhole)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a openai.com"; dns.query; content:"openai.com"; nocase; classtype:policy-violation; sid:1000090; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a anthropic.com"; dns.query; content:"anthropic.com"; nocase; classtype:policy-violation; sid:1000091; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a deepseek.com"; dns.query; content:"deepseek.com"; nocase; classtype:policy-violation; sid:1000092; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a perplexity.ai"; dns.query; content:"perplexity.ai"; nocase; classtype:policy-violation; sid:1000093; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a mistral.ai"; dns.query; content:"mistral.ai"; nocase; classtype:policy-violation; sid:1000094; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"[AI-DETECT] DNS query a gemini.google.com"; dns.query; content:"gemini.google.com"; nocase; classtype:policy-violation; sid:1000095; rev:1;)

# 5.10 DNS-over-HTTPS evasion — peticiones DoH a proveedores externos
alert http $HOME_NET any -> any 443 (msg:"[AI-DETECT] Peticion DoH a dns.google (evasion sinkhole)"; flow:to_server,established; http.host; content:"dns.google"; nocase; classtype:policy-violation; sid:1000096; rev:1;)
alert http $HOME_NET any -> any 443 (msg:"[AI-DETECT] Peticion DoH a cloudflare-dns.com (evasion sinkhole)"; flow:to_server,established; http.host; content:"cloudflare-dns.com"; nocase; classtype:policy-violation; sid:1000097; rev:1;)


# -----------------------------------------------------------------------------
# 6) EXTRA — pistas de exfiltración / túneles
# -----------------------------------------------------------------------------

# 6.1 DNS tunneling: tasa de consultas anormalmente alta desde un mismo src.
alert dns $HOME_NET any -> any 53 (msg:"[DNS] Tasa de consultas DNS anormal (posible tunneling)"; threshold:type both, track by_src, count 100, seconds 10; classtype:bad-unknown; sid:1000040; rev:1;)

# 6.2 Consulta DNS con payload muy largo (FQDN > 100 chars) — señal de tunneling.
alert dns any any -> any 53 (msg:"[DNS] FQDN largo en consulta DNS (posible DNS tunneling)"; dns.query; pcre:"/.{100,}/"; classtype:bad-unknown; sid:1000041; rev:1;)
