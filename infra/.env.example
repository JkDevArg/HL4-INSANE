# CTFHL4-INSANE — Variables de entorno de la orquestación.
# Copia a .env y rellena. NO commitear .env.

# Flags (flag-service). Genera: openssl rand -hex 32
MASTER_SECRET=cambia_esto_por_string_aleatorio_de_64_chars

# JWT de la plataforma. Genera: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_otro_secreto_largo

# PostgreSQL
POSTGRES_PASSWORD=cambia_esta_password_de_db

# Grafana (admin del SIEM)
GRAFANA_PASSWORD=pon_password_seguro_aqui

# Panel admin propio (recursos + control ON/OFF por equipo).
# Solo accesible por túnel SSH a 127.0.0.1:8091. Genera: openssl rand -hex 24
ADMIN_PASSWORD=pon_password_admin_del_panel_aqui

# Discord webhook para alertas del SIEM (opcional, deja vacío para desactivar)
DISCORD_WEBHOOK_URL=
