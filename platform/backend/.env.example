# --- Base de datos / cache (nombres de host Docker) ---
DATABASE_URL=postgresql+asyncpg://ctf:ctf@postgres:5432/ctf
REDIS_URL=redis://redis:6379/0

# --- Servicios internos (red 10.10.100.0/24) ---
FLAG_SERVICE_URL=http://flag-service:8001
COLLECTOR_URL=http://collector:9000

# --- JWT ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Gate de red (solo VPN) ---
VPN_CIDR=10.10.0.0/16
# true si la API esta detras de nginx (usa X-Forwarded-For)
TRUST_FORWARDED_FOR=true

# --- Politicas ---
SUBMIT_RATE_LIMIT=10
SUBMIT_RATE_WINDOW=60
MAX_SESSIONS_PER_TEAM=4
SESSION_TTL_SECONDS=43200
TEAM_COUNT=10

# NOTA: el MASTER_SECRET de las flags NO vive aqui. La validacion de flags
# se delega siempre al flag-service.
